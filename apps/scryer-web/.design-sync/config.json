{
  "projectId": "57a94241-1a6d-43f6-81af-dc108dcf97c5",
  "pkg": "scryer-web",
  "globalName": "ScryerWeb",
  "shape": "package",
  "entry": ".design-sync/ds-entry.ts",
  "srcDir": "components/ui",
  "tsconfig": "tsconfig.json",
  "buildCmd": "node .design-sync/build-css.mjs",
  "cssEntry": ".design-sync/.cache/ds.css",
  "extraFonts": [".design-sync/fonts.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "Button": "components/ui/button.tsx",
    "Card": "components/ui/card.tsx",
    "Checkbox": "components/ui/checkbox.tsx",
    "Collapsible": "components/ui/collapsible.tsx",
    "Command": "components/ui/command.tsx",
    "Dialog": "components/ui/dialog.tsx",
    "HoverCard": "components/ui/hover-card.tsx",
    "Input": "components/ui/input.tsx",
    "Label": "components/ui/label.tsx",
    "Popover": "components/ui/popover.tsx",
    "Progress": "components/ui/progress.tsx",
    "Select": "components/ui/select.tsx",
    "Separator": "components/ui/separator.tsx",
    "Sheet": "components/ui/sheet.tsx",
    "Sidebar": "components/ui/sidebar.tsx",
    "Skeleton": "components/ui/skeleton.tsx",
    "Toaster": "components/ui/sonner.tsx",
    "Table": "components/ui/table.tsx",
    "Tabs": "components/ui/tabs.tsx",
    "Textarea": "components/ui/textarea.tsx",
    "TimePicker": "components/ui/time-picker.tsx",
    "ToggleGroup": "components/ui/toggle-group.tsx",
    "Tooltip": "components/ui/tooltip.tsx"
  },
  "overrides": {
    "Dialog": { "cardMode": "single", "primaryStory": "Default", "viewport": "760x520" },
    "Sheet": { "cardMode": "single", "primaryStory": "Right", "viewport": "960x560" },
    "Popover": { "cardMode": "single", "primaryStory": "Default", "viewport": "520x460" },
    "HoverCard": { "cardMode": "single", "primaryStory": "Default", "viewport": "560x380" },
    "Tooltip": { "cardMode": "single", "primaryStory": "Default", "viewport": "460x320" },
    "Select": { "cardMode": "single", "primaryStory": "Open", "viewport": "520x520" },
    "Command": { "cardMode": "single", "primaryStory": "Palette", "viewport": "640x520" },
    "Table": { "cardMode": "column" },
    "Sidebar": { "cardMode": "single", "primaryStory": "Navigation", "viewport": "380x560" },
    "Toaster": { "cardMode": "single", "primaryStory": "Notifications", "viewport": "480x440" }
  }
}
