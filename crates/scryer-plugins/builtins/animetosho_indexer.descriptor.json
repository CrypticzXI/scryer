{
  "id": "animetosho",
  "name": "AnimeTosho Indexer",
  "provider": {
    "capabilities": {
      "anidb_search": true,
      "deduplicates_aliases": true,
      "feed_modes": [
        "recent",
        "rss",
        "automatic_search",
        "interactive_search"
      ],
      "imdb_search": false,
      "limits": {
        "api_quota_supported": false,
        "grab_quota_supported": false,
        "max_page_size": 75,
        "max_pages": 14,
        "page_size": 75
      },
      "protocols": [
        "mixed"
      ],
      "query_param": "q",
      "response_features": {
        "comments": false,
        "grabs": false,
        "guid": false,
        "info_url": true,
        "languages": false,
        "password_hint": false,
        "protection_hint": false,
        "raw_provider_metadata": true,
        "subtitles": false,
        "votes": false
      },
      "rss": true,
      "search": true,
      "search_inputs": [
        "title_query",
        "id_query",
        "absolute_episode",
        "episode",
        "limit"
      ],
      "supported_external_ids": [
        "anidb_id"
      ],
      "supported_ids": {
        "anime": [
          "anidb_id"
        ],
        "movie": [
          "anidb_id"
        ]
      },
      "torrent": {
        "reports_info_hash": true,
        "reports_leechers": true,
        "reports_magnet_uri": true,
        "reports_peers": false,
        "reports_seeders": true,
        "reports_volume_factors": false,
        "supports_private_tracker_flags": false,
        "supports_seed_requirements": false
      },
      "tvdb_search": false
    },
    "kind": "indexer",
    "provider_type": "animetosho",
    "source_kind": "generic"
  },
  "sdk_constraint": ">=1.6.0, <1.7.0",
  "sdk_version": "1.6.0",
  "version": "0.3.8"
}
