{
  "id": "nzbgeek",
  "name": "NZBGeek Indexer",
  "provider": {
    "capabilities": {
      "anidb_search": false,
      "category_model": {
        "provider_category_metadata": true,
        "separate_anime_categories": true,
        "value_kinds": [
          "numeric"
        ]
      },
      "deduplicates_aliases": false,
      "episode_param": "ep",
      "feed_modes": [
        "recent",
        "rss",
        "automatic_search",
        "interactive_search"
      ],
      "imdb_search": true,
      "limits": {
        "api_quota_supported": true,
        "grab_quota_supported": true,
        "max_page_size": 100,
        "max_pages": 10,
        "page_size": 100
      },
      "protocols": [
        "usenet"
      ],
      "query_param": "q",
      "response_features": {
        "comments": true,
        "grabs": true,
        "guid": true,
        "info_url": true,
        "languages": true,
        "password_hint": true,
        "protection_hint": true,
        "raw_provider_metadata": true,
        "subtitles": true,
        "votes": false
      },
      "rss": true,
      "search": true,
      "search_inputs": [
        "title_query",
        "id_query",
        "season",
        "episode",
        "category",
        "limit"
      ],
      "season_param": "season",
      "supported_external_ids": [
        "imdb_id",
        "tvdb_id",
        "tmdb_id",
        "tvmaze_id",
        "tvrage_id"
      ],
      "supported_ids": {
        "anime": [
          "tvdb_id"
        ],
        "movie": [
          "imdb_id"
        ],
        "series": [
          "tvdb_id"
        ]
      },
      "tvdb_search": true
    },
    "kind": "indexer",
    "provider_type": "nzbgeek",
    "scoring_policies": [
      {
        "name": "nzbgeek_vote_penalty",
        "rego_source": "package scryer.rules.user.plugin_nzbgeek_vote_penalty\nimport rego.v1\n\nscore_entry[\"nzbgeek_thumbs_down\"] := penalty if {\n    td := input.release.extra.thumbs_down\n    td > 5\n    extra := min([td - 5, 10])\n    penalty := -2400 - (extra * 300)\n}\n"
      },
      {
        "name": "nzbgeek_language_bonus",
        "rego_source": "package scryer.rules.user.plugin_nzbgeek_language_bonus\nimport rego.v1\n\nscore_entry[\"nzbgeek_english_confirmed\"] := 200 if {\n    langs := input.release.extra.languages\n    count(langs) > 0\n    some lang in langs\n    lower(lang) == \"english\"\n}\n"
      }
    ],
    "source_kind": "usenet"
  },
  "sdk_constraint": ">=1.5.0, <1.6.0",
  "sdk_version": "1.5.0",
  "version": "0.2.7"
}
