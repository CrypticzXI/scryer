#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
config_path="$repo_root/.gitleaks.toml"

run_gitleaks() {
  output_file="$1"
  if [ -f "$config_path" ]; then
    config_args="--config=$config_path"
  else
    config_args=""
  fi

  set +e
  gitleaks protect --staged --redact $config_args >"$output_file" 2>&1
  status=$?
  set -e
  if [ $status -eq 0 ]; then
    return 0
  fi
  if grep -Eiq 'unknown command|unknown flag|accepts [0-9]+ arg|unexpected argument|help for' "$output_file"; then
    set +e
    gitleaks git "$repo_root" --staged --redact $config_args >"$output_file" 2>&1
    status=$?
    set -e
    if [ $status -eq 0 ]; then
      return 0
    fi
  fi

  echo "pre-commit blocked: gitleaks found possible secrets in staged changes." >&2
  sed 's/^/  /' "$output_file" >&2
  return 1
}

run_fallback_scan() {
  tmp_output="$1"
  git diff --cached --no-color --unified=0 --diff-filter=ACMR -- . | \
  while IFS= read -r line; do
    case "$line" in
      "+++ b/"*)
        current_file="${line#+++ b/}"
        ;;
      "+"*)
        case "$line" in
          "+++"*) continue ;;
        esac
        added_line="${line#?}"

        secret_label=""
        if printf '%s\n' "$added_line" | grep -Eq 'BEGIN [A-Z0-9 ]*PRIVATE KEY'; then
          secret_label="private key material"
        elif printf '%s\n' "$added_line" | grep -Eq 'github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,}'; then
          secret_label="GitHub token"
        elif printf '%s\n' "$added_line" | grep -Eq 'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}'; then
          secret_label="AWS access key"
        elif printf '%s\n' "$added_line" | grep -Eq 'sk-(proj-)?[A-Za-z0-9_-]{20,}'; then
          secret_label="OpenAI-style key"
        elif printf '%s\n' "$added_line" | grep -Eqi '(api[_-]?key|access[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*(["'\''][^"'\'']{8,}["'\'']|[A-Za-z0-9/+_.=-]{24,})'; then
          if ! printf '%s\n' "$added_line" | grep -Eqi 'example|sample|placeholder|changeme|replace-me|replace_me|dummy|fake|test[-_]?key|test[-_]?token'; then
            secret_label="generic credential assignment"
          fi
        fi

        if [ -n "$secret_label" ]; then
          printf '%s:%s: %s\n' "${current_file:-unknown}" "$secret_label" "$added_line" >> "$tmp_output"
        fi
        ;;
    esac
  done

  if [ -s "$tmp_output" ]; then
    echo "pre-commit blocked: staged changes contain possible secrets." >&2
    echo "Install gitleaks for stronger checks, or remove/generalize these lines:" >&2
    sed 's/^/  - /' "$tmp_output" >&2
    return 1
  fi
}

tmp_output="$(mktemp "${TMPDIR:-/tmp}/scryer-secret-scan.XXXXXX")"
trap 'rm -f "$tmp_output"' EXIT HUP INT TERM

if command -v gitleaks >/dev/null 2>&1; then
  run_gitleaks "$tmp_output"
else
  run_fallback_scan "$tmp_output"
fi
